# Copy this file to backend/.env for local development.
# Never commit the real .env file — it is gitignored.

# Django
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=True
# Comma-separated hostnames. Example for Railway: soccermind.up.railway.app
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins (with scheme) allowed to pass CSRF checks.
# Example for Railway: https://soccermind.up.railway.app
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to True only once the app is served over HTTPS (e.g. on Railway).
# Keep False for local http:// development or cookies won't be sent.
DJANGO_SECURE_COOKIES=False

# Database (PostgreSQL in both development and production)
DATABASE_URL=postgresql://soccermind_dev:soccermind_dev_local_pw@127.0.0.1:5432/soccermind_dev

# CORS: only needed if the frontend is ever served from a different origin
# than the backend (not the default same-origin production setup).
DJANGO_CORS_ALLOWED_ORIGINS=
